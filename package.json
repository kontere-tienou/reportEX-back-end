{
  "name": "batex-reporting-backend",
  "version": "1.0.0",
  "description": "BATEX-CI Reporting System Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm install --production=false && npm rebuild",
    "railway-build": "npm install --production=false && npm rebuild pg",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js",
    "migrate": "node src/scripts/migrate.js",
    "init-db": "node src/config/initDatabase.js",
    "seed": "node scripts/seed.js",
    "db:init": "node scripts/init-db.js",
    "dev:watch": "nodemon --watch server.js --watch src --watch .env --ext js,json,env server.js",
    "debug": "nodemon --inspect server.js"
  },
  "keywords": [
    "erp",
    "batex",
    "api",
    "nodejs"
  ],
  "author": "BATEX-CI",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.98.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "canvas": "^3.2.1",
    "chart.js": "^4.5.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^3.0.3",
    "nodemailer": "7.0.11",
    "pdfkit": "^0.13.0",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
